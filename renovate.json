{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "uses: golangci/golangci-lint-action[^\\n]+\\n\\s+with:\\n(?:[^\\n]+\\n)*?\\s+version:\\s*(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "GOSEC_VERSION:\\s*(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "securego/gosec",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "golang"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
